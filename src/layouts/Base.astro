---
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import { t, altPath, type Locale } from '../i18n/strings';

export interface Props { locale: Locale; path?: string; pageTitle?: string; }
const { locale, path = '/', pageTitle } = Astro.props;
const s = t(locale);
const other = altPath(locale, path);
const home = locale === 'ja' ? '/ja' : '/';
/* Home keeps the full brand title; sub-pages get "Page — EN2U". */
const title = pageTitle ? `${pageTitle} — EN2U` : s.siteTitle;
const canonical = new URL(locale === 'ja' ? `/ja${path === '/' ? '' : path}` : path, Astro.site ?? 'https://en2u.vercel.app');
---
<!doctype html>
<html lang={s.htmlLang} class="no-js">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={s.metaDesc} />
  <link rel="canonical" href={canonical.href} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={s.metaDesc} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={locale === 'ja' ? 'ja_JP' : 'en_US'} />
  <link rel="icon" href="/pictures/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" href="/pictures/apple-touch-icon.png" />
  <meta name="theme-color" content="#ECEBE4" />
  <link rel="alternate" hreflang={locale === 'en' ? 'ja' : 'en'} href={other} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href={
      locale === 'ja'
        ? 'https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Sans+JP:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Zen+Kaku+Gothic+New:wght@700;900&display=swap'
        : 'https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Zen+Kaku+Gothic+New:wght@700;900&display=swap'
    }
  />
  <script is:inline>
    /* Swap no-js -> js before first paint so reveals can start hidden
       without ever trapping content for non-JS users. */
    document.documentElement.classList.remove('no-js');
  </script>
</head>
<body>
  <a class="skip-link" href="#main">{s.nav.skip}</a>

  <header class="site-nav">
    <div class="wrap nav-inner">
      <a href={home} class="brand" aria-label="EN2U">
        <Mark size={30} detail="compact" />
        <b>EN2U</b>
      </a>
      <nav class="nav-links" aria-label={locale === 'ja' ? 'メインナビゲーション' : 'Main'}>
        <a class="nav-item" href={`${home === '/' ? '' : home}/what-we-do`}
           aria-current={path === '/what-we-do' ? 'page' : undefined}>{s.nav.what}</a>
        <a class="nav-item" href={`${home === '/' ? '' : home}/impact`}
           aria-current={path === '/impact' ? 'page' : undefined}>{s.nav.impact}</a>

        <!-- A language switch is a different kind of control from a destination,
             so it is separated by a rule and shows BOTH states. Previously it was
             the only boxed thing in the bar, which made the toggle read as the
             primary button and the actual navigation read as grey caption text. -->
        <span class="nav-sep" aria-hidden="true"></span>
        <span class="langset" role="group" aria-label={s.nav.toggleLabel}>
          <a href={locale === 'en' ? '/' : other} class={locale === 'en' ? 'on' : ''}
             aria-current={locale === 'en' ? 'true' : undefined} data-lang-link>EN</a>
          <a href={locale === 'ja' ? '/ja' : other} class={locale === 'ja' ? 'on' : ''}
             aria-current={locale === 'ja' ? 'true' : undefined} data-lang-link>日本語</a>
        </span>
      </nav>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap foot-inner">
      <div>
        <b>{s.footer.rights}</b>
        <p class="meta">{s.footer.tag}</p>
      </div>
      <div class="foot-links meta">
        <a href="https://www.instagram.com/en2u_npo/" target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href="mailto:en2u.org@gmail.com">Email</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    /* ---- reveal + stagger + count-up: one IntersectionObserver, ~700 bytes.
       No animation library. Budget: 40KB allowed, 0KB used. ---- */
    (function () {
      var els = document.querySelectorAll('[data-reveal]');
      if (!('IntersectionObserver' in window)) {
        els.forEach(function (el) { el.classList.add('is-in'); });
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -5% 0px' });
      els.forEach(function (el) { io.observe(el); });

      /* Preserve scroll position across the locale toggle (§6). */
      var links = document.querySelectorAll('[data-lang-link]');
      if (links.length) {
        links.forEach(function (link) {
          link.addEventListener('click', function () {
            try { sessionStorage.setItem('en2u:y', String(window.scrollY)); } catch (_) {}
          });
        });
        try {
          var y = sessionStorage.getItem('en2u:y');
          if (y !== null) {
            sessionStorage.removeItem('en2u:y');
            window.scrollTo(0, parseInt(y, 10) || 0);
          }
        } catch (_) {}
      }
    })();
  </script>

  <style is:global>
    .site-nav {
      position: sticky; top: 0; z-index: 50;
      background: color-mix(in srgb, var(--bg) 88%, transparent);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--hairline);
    }
    .nav-inner {
      display: flex; align-items: center; justify-content: space-between;
      padding-block: var(--s-3);
    }
    .brand { display: inline-flex; align-items: center; gap: var(--s-3); text-decoration: none; }
    .brand b {
      font-family: var(--font-display);
      font-size: 1.25rem; font-weight: 900; letter-spacing: -0.02em;
    }
    .nav-links { display: flex; align-items: center; gap: var(--s-5); }

    /* Destinations: ink, not grey, and each carries a persistent rule underneath
       so it reads as something you can go to rather than a caption. */
    .nav-item {
      position: relative;
      color: var(--ink); text-decoration: none;
      font-size: 1rem; font-weight: 500;
      padding-block: var(--s-2);
    }
    .nav-item::after {
      content: ''; position: absolute; left: 0; right: 0; bottom: 0;
      height: 2px; background: var(--ink); opacity: .2;
      transition: opacity var(--d-micro) var(--ease-entrance),
                  background-color var(--d-micro) var(--ease-entrance);
    }
    .nav-item:hover::after { opacity: .55; }
    .nav-item[aria-current="page"]::after { background: var(--accent); opacity: 1; }

    .nav-sep { width: 1px; height: 20px; background: var(--hairline); }

    /* Segmented switch showing both languages, current one filled. A single
       button labelled with the OTHER language is ambiguous — it never says
       whether it names the current state or the destination. */
    .langset {
      display: inline-flex; align-items: stretch;
      border: 1px solid var(--hairline); border-radius: var(--radius);
      overflow: hidden;
    }
    .langset a {
      color: var(--muted); text-decoration: none;
      font-size: var(--t-meta); font-weight: 500; line-height: 1;
      padding: var(--s-2) var(--s-3);
      transition: background-color var(--d-micro), color var(--d-micro);
    }
    .langset a:hover { background: var(--hairline); color: var(--ink); }
    .langset a.on { background: var(--ink); color: var(--bg); }
    .langset a.on:hover { background: var(--ink); color: var(--bg); }

    /* Nav labels must never break. Without this the global
       :lang(ja) { overflow-wrap: anywhere } rule — which exists for body copy —
       splits them mid-word at narrow widths (EN2 / U, 活動内 / 容). */
    .brand b, .nav-item, .langset a { white-space: nowrap; overflow-wrap: normal; }

    @media (max-width: 620px) {
      .nav-links { gap: var(--s-3); }
      .nav-item { font-size: 0.9375rem; }
      /* The wordmark is the first thing to go: the mark alone still identifies
         the site, and 375px cannot fit brand + two destinations + two languages. */
      .brand b { display: none; }
      .nav-sep { display: none; }
      .langset a { padding: var(--s-2); }
    }

    .site-footer { border-top: 1px solid var(--hairline); padding-block: var(--s-6); margin-top: var(--s-8); }
    .foot-inner { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--s-5); flex-wrap: wrap; }
    .foot-links { display: flex; gap: var(--s-5); }
    .foot-links a { text-decoration: none; }
    .foot-links a:hover { color: var(--ink); }
  </style>
</body>
</html>
