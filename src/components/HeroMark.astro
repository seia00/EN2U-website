---
import Mark from './Mark.astro';
/**
 * Large brand mark for the hero's empty right column. The idle motion lives in
 * Mark (`spin`) so the nav logo can share it; this file only places the mark.
 */
---
<div class="hero-mark" aria-hidden="true">
  <Mark size={360} detail="full" decorative spin />
</div>

<style>
  .hero-mark {
    justify-self: end;
    align-self: center;
    width: clamp(210px, 25vw, 340px);
    pointer-events: none;
  }
  /* Styles reach into Mark's svg, so they need :global — Astro scopes component
     CSS to the component that declares it. */
  .hero-mark :global(svg) { width: 100%; height: auto; }

  /* Below the 2-column breakpoint the hero is text-only — a mark stacked above
     the headline would push the LCP element down the page. */
  @media (max-width: 860px) { .hero-mark { display: none; } }
</style>
