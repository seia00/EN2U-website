---
import Mark from './Mark.astro';
/**
 * Large brand mark for the hero's empty right column.
 *
 * Motion: the rainbow ring rotates slowly (48s) so the hue under any given
 * point drifts; the two hands orbit at 28s and 36s in opposite directions; the
 * planet stays still. Nothing shares a period, so the composition never settles
 * into a visible loop.
 *
 * Deliberately not a spin of the whole mark — at spin speed a ringed circular
 * logo reads as a loading spinner. To do that anyway: put `orbit 20s linear
 * infinite` on `.hero-mark :global(svg)` and delete the three rules below.
 *
 * Styles reach into Mark's internals, so they need :global — Astro scopes
 * component CSS to the component that declares it.
 */
---
<div class="hero-mark" aria-hidden="true">
  <Mark size={360} detail="full" decorative />
</div>

<style>
  .hero-mark {
    justify-self: end;
    align-self: center;
    width: clamp(210px, 25vw, 340px);
    pointer-events: none;
  }
  .hero-mark :global(svg) { width: 100%; height: auto; }

  .hero-mark :global(.mk-ring),
  .hero-mark :global(.mk-arm-l),
  .hero-mark :global(.mk-arm-r) {
    transform-box: view-box;
    transform-origin: 32px 32px;
  }
  /* Both hands orbit the same circle at r=22 about (32,32), counter-rotating on
     different periods so they meet, part, and meet again at a point that keeps
     moving around the ring. This only glides cleanly because the two arcs are
     genuinely concentric — see the note in Mark.astro. */
  .hero-mark :global(.mk-ring)  { animation: orbit 48s linear infinite; }
  .hero-mark :global(.mk-arm-r) { animation: orbit 28s linear infinite; }
  .hero-mark :global(.mk-arm-l) { animation: orbit 36s linear infinite reverse; }

  @keyframes orbit { to { transform: rotate(360deg); } }

  /* Below the 2-column breakpoint the hero is text-only — a mark stacked above
     the headline would push the LCP element down the page, and a forever-looping
     animation on a phone costs battery for something barely visible. */
  @media (max-width: 860px) { .hero-mark { display: none; } }

  @media (prefers-reduced-motion: reduce) {
    .hero-mark :global(.mk-ring),
    .hero-mark :global(.mk-arm-l),
    .hero-mark :global(.mk-arm-r) { animation: none; }
  }
</style>
