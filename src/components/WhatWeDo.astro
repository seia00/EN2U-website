---
import { t, type Locale } from '../i18n/strings';
export interface Props { locale: Locale; }
const { locale } = Astro.props;
const s = t(locale);
const p = s.whatPage;
---
<section class="section page-head">
  <div class="wrap">
    <h1 class="display">{p.title}</h1>
    <p class="lead page-lead">{p.lead}</p>
  </div>
</section>

<section class="section" id="model">
  <div class="wrap">
    <p class="eyebrow" data-reveal><span class="n">{p.model.n}</span> {p.model.eyebrow}</p>
    <div class="grid-2 head-grid">
      <h2 class="title" data-reveal>{p.model.title}</h2>
      <p class="body" data-reveal style="--i:1">{p.model.body}</p>
    </div>
    <div class="grid-3 cards" data-stagger>
      {s.what.cards.map((c, i) => (
        <article class="card" data-lift data-reveal style={`--i:${i}`}>
          <h3>{c.t}</h3>
          <p>{c.b}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Mentor criteria as a sequence of thresholds. The selectivity is the message,
     and the threshold rule is the same primitive used for the impact stats. -->
<section class="section" id="mentors">
  <div class="wrap">
    <p class="eyebrow" data-reveal><span class="n">{p.mentors.n}</span> {p.mentors.eyebrow}</p>
    <div class="grid-2 head-grid">
      <h2 class="title" data-reveal>{p.mentors.title}</h2>
      <p class="body" data-reveal style="--i:1">{p.mentors.body}</p>
    </div>
    <ol class="gate" data-stagger>
      {p.mentors.steps.map((st, i) => (
        <li class="threshold gate-step" data-reveal style={`--fill:${st.fill}; --i:${i}`}>
          <span class="gate-n">{String(i + 1).padStart(2, '0')}</span>
          <div class="gate-body">
            <h3 class="th-label gate-title">{st.t}</h3>
            <div class="th-rule"><i></i></div>
            <p class="th-note">{st.b}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .page-head { padding-block: clamp(48px, 9vw, 96px) var(--s-7); }
  .page-lead { margin-top: var(--s-4); }
  .head-grid { align-items: start; margin-bottom: var(--s-7); }
  .cards { margin-top: var(--s-5); }

  .gate { list-style: none; margin-top: var(--s-5); display: grid; gap: var(--s-5); }
  .gate-step {
    display: grid; grid-template-columns: auto 1fr; gap: var(--s-5);
    align-items: start;
    padding-top: var(--s-5); border-top: 1px solid var(--hairline);
  }
  .gate-n {
    font-family: var(--font-mono); font-size: var(--t-meta);
    color: var(--accent); padding-top: 2px;
  }
  .gate-title { font-size: var(--t-body); font-weight: 600; margin-bottom: var(--s-3); }
  .gate-body .th-note { max-width: 60ch; }
  @media (max-width: 760px) {
    .gate-step { grid-template-columns: auto 1fr; gap: var(--s-4); }
  }
</style>
