---
import { t, type Locale } from '../i18n/strings';
import HeroMark from './HeroMark.astro';
import WhatSection from './WhatSection.astro';
import WhereSection from './WhereSection.astro';
import ImpactSection from './ImpactSection.astro';
export interface Props { locale: Locale; }
const { locale } = Astro.props;
const s = t(locale);
---

{/* ── HERO ──────────────────────────────────────────────────────────────
     Exactly one screen tall (below the sticky nav), so nothing from the next
     section peeks in at the bottom edge. Fully present in the SSR'd HTML and
     visible on first paint (no reveal on the h1) so LCP is never blocked. */}
<section class="section hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{s.hero.eyebrow}</p>
      <h1 class="display">{s.hero.title}</h1>
      <p class="lead hero-lead">{s.hero.lead}</p>
    </div>
    <HeroMark />
  </div>
</section>

<WhatSection locale={locale} />
<WhereSection locale={locale} />
<ImpactSection locale={locale} />

{/* ── 04 CONTACT ─────────────────────────────────────────────────────── */}
<section class="section" id="contact">
  <div class="wrap">
    <p class="eyebrow" data-reveal><span class="n">{s.contact.n}</span> {s.contact.eyebrow}</p>
    <h2 class="title" data-reveal>{s.contact.title}</h2>
    <p class="body contact-body" data-reveal style="--i:1">{s.contact.body}</p>
    <p class="btnrow" data-reveal style="--i:2">
      <a class="btn" href="https://www.instagram.com/en2u_npo/" target="_blank" rel="noopener noreferrer">{s.contact.ig}</a>
      <a class="btn btn-ghost" href="mailto:en2u.org@gmail.com">{s.contact.mail}</a>
    </p>
  </div>
</section>

<style>
  .hero {
    /* 100svh = the small viewport, so mobile browser chrome can't push the
       bottom of the hero below the fold. The content is centred in the space. */
    min-height: calc(100svh - var(--nav-h));
    display: grid; align-content: center;
    padding-block: var(--s-8);
  }
  /* A grid item with auto margins shrinks to its content; keep it full-width. */
  .hero > .wrap { width: 100%; }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--s-7);
    align-items: center;
  }
  @media (max-width: 860px) { .hero-grid { grid-template-columns: 1fr; } }
  .hero-lead { margin-top: var(--s-5); font-size: var(--t-lead); }
  :global(:lang(ja)) .hero-lead { line-height: var(--lh-body-ja); }

  .contact-body { margin-top: var(--s-4); }
  .btnrow { display: flex; gap: var(--s-3); margin-top: var(--s-5); flex-wrap: wrap; }
</style>
