---
import { t, type Locale } from '../i18n/strings';
import HeroMark from './HeroMark.astro';
export interface Props { locale: Locale; }
const { locale } = Astro.props;
const s = t(locale);
---

<!-- ── HERO ──────────────────────────────────────────────────────────────
     Fully present in the SSR'd HTML and visible on first paint (no reveal
     on the h1) so LCP is never blocked. -->
<section class="section hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{s.hero.eyebrow}</p>
      <h1 class="display">{s.hero.title}</h1>
      <p class="lead hero-lead">{s.hero.lead}</p>
    </div>
    <HeroMark />
  </div>
</section>

<!-- ── 01 WHAT WE DO ──────────────────────────────────────────────────── -->
<section class="section" id="what">
  <div class="wrap">
    <p class="eyebrow" data-reveal><span class="n">{s.what.n}</span> {s.what.eyebrow}</p>
    <div class="grid-2 head-grid">
      <h2 class="title" data-reveal>{s.what.title}</h2>
      <p class="body" data-reveal style="--i:1">{s.what.body}</p>
    </div>
    <div class="grid-3 cards" data-stagger>
      {s.what.cards.map((c, i) => (
        <article class="card" data-lift data-reveal style={`--i:${i}`}>
          <h3>{c.t}</h3>
          <p>{c.b}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ── 02 WHERE WE WORK ───────────────────────────────────────────────────
     The accuracy section. Guatemala (we taught) and Gaza (we supplied the
     curriculum) get visibly different treatments — deliberately NOT a world
     map with three identical pins. -->
<section class="section" id="where">
  <div class="wrap">
    <p class="eyebrow" data-reveal><span class="n">{s.where.n}</span> {s.where.eyebrow}</p>
    <div class="grid-2 head-grid">
      <h2 class="title" data-reveal>{s.where.title}</h2>
      <p class="body" data-reveal style="--i:1">{s.where.body}</p>
    </div>

    <ol class="nodes" data-stagger>
      {s.where.nodes.map((n, i) => (
        <li class={`node node--${n.kind}`} data-reveal style={`--i:${i}`}>
          <span class="node-dot" aria-hidden="true"></span>
          <div class="node-body">
            <div class="node-head">
              <h3 class="node-place">{n.place}</h3>
              <span class="node-role">{n.role}</span>
            </div>
            <p class="node-text">{n.b}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- ── 03 IMPACT ──────────────────────────────────────────────────────── -->
<section class="section" id="impact">
  <div class="wrap">
    <p class="eyebrow" data-reveal><span class="n">{s.impact.n}</span> {s.impact.eyebrow}</p>
    <div class="grid-2 head-grid">
      <h2 class="title" data-reveal>{s.impact.title}</h2>
      <p class="body" data-reveal style="--i:1">{s.impact.note}</p>
    </div>

    <p class="meta stats-head" data-reveal>{s.impact.statsHead}</p>
    <div class="grid-3 stats" data-stagger>
      {s.impact.stats.map((st, i) => (
        <div class="threshold" data-reveal style={`--fill:${st.fill}; --i:${i}`}>
          <div class="th-value">{st.v}</div>
          <div class="th-label">{st.l}</div>
          <div class="th-rule"><i></i></div>
          <div class="th-note">{st.n}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ── 04 CONTACT ─────────────────────────────────────────────────────── -->
<section class="section" id="contact">
  <div class="wrap">
    <p class="eyebrow" data-reveal><span class="n">{s.contact.n}</span> {s.contact.eyebrow}</p>
    <h2 class="title" data-reveal>{s.contact.title}</h2>
    <p class="body contact-body" data-reveal style="--i:1">{s.contact.body}</p>
    <p class="btnrow" data-reveal style="--i:2">
      <a class="btn" href="https://www.instagram.com/en2u_npo/" target="_blank" rel="noopener noreferrer">{s.contact.ig}</a>
      <a class="btn btn-ghost" href="mailto:en2u.org@gmail.com">{s.contact.mail}</a>
    </p>
  </div>
</section>

<style>
  .hero { padding-block: clamp(56px, 12vw, 128px) var(--section-y); }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--s-7);
    align-items: center;
  }
  @media (max-width: 860px) { .hero-grid { grid-template-columns: 1fr; } }
  .hero-lead { margin-top: var(--s-5); font-size: var(--t-lead); }
  :global(:lang(ja)) .hero-lead { line-height: var(--lh-body-ja); }

  .head-grid { align-items: start; margin-bottom: var(--s-7); }
  .cards, .stats { margin-top: var(--s-5); }
  .stats-head { margin-top: var(--s-6); }

  /* ---- the where-we-work nodes ---- */
  .nodes { list-style: none; margin-top: var(--s-5); }
  .node {
    display: grid; grid-template-columns: 20px 1fr; gap: var(--s-5);
    padding-block: var(--s-5);
    border-top: 1px solid var(--hairline);
  }
  .node:last-child { border-bottom: 1px solid var(--hairline); }
  .node-dot {
    width: 13px; height: 13px; border-radius: 50%;
    margin-top: 6px; border: 2px solid var(--muted);
  }
  /* base = hollow · direct = solid (we were in the room) · curriculum = half */
  .node--direct     .node-dot { background: var(--accent); border-color: var(--accent); }
  .node--curriculum .node-dot {
    border-color: var(--accent);
    background: linear-gradient(90deg, var(--accent) 50%, transparent 50%);
  }
  .node-head { display: flex; align-items: baseline; gap: var(--s-3); flex-wrap: wrap; }
  .node-place { font-size: var(--t-body); font-weight: 600; }
  .node-role {
    font-family: var(--font-mono); font-size: 0.75rem;
    letter-spacing: 0.04em; color: var(--accent);
    border: 1px solid var(--hairline); border-radius: var(--radius);
    padding: 1px var(--s-2);
  }
  .node-text { font-size: var(--t-meta); color: var(--muted); margin-top: var(--s-2); max-width: 62ch; }

  .contact-body { margin-top: var(--s-4); }
  .btnrow { display: flex; gap: var(--s-3); margin-top: var(--s-5); flex-wrap: wrap; }

  @media (max-width: 760px) {
    .node { grid-template-columns: 16px 1fr; gap: var(--s-4); }
  }
</style>
