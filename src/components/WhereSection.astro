---
import { t, type Locale } from '../i18n/strings';
import WorldMap from './WorldMap.astro';
export interface Props { locale: Locale; }
const { locale } = Astro.props;
const s = t(locale);
const w = s.where;
---
{/* ── 02 WHERE WE WORK ───────────────────────────────────────────────────
     The accuracy section. Each place says how we relate to it, and the map pins
     repeat the same dot vocabulary. A place with no role or description is one
     where we work but the relationship hasn't been stated — it is shown as that,
     not rounded up to "we taught". */}
<section class="section" id="where">
  <div class="wrap">
    <p class="eyebrow" data-reveal><span class="n">{w.n}</span> {w.eyebrow}</p>
    <div class="grid-2 head-grid">
      <h2 class="title" data-reveal>{w.title}</h2>
      <p class="body" data-reveal style="--i:1">{w.body}</p>
    </div>

    <div class="where-grid">
      <ol class="nodes" data-stagger>
        {w.nodes.map((n, i) => (
          <li class={`node node--${n.kind}`} data-reveal style={`--i:${i}`}>
            <span class="node-dot" aria-hidden="true"></span>
            <div class="node-body">
              <div class="node-head">
                <h3 class="node-place">{n.place}</h3>
                {n.role && <span class="node-role">{n.role}</span>}
              </div>
              {n.b && <p class="node-text">{n.b}</p>}
            </div>
          </li>
        ))}
      </ol>

      <figure class="map" data-reveal style="--i:2">
        <WorldMap label={w.mapLabel} nodes={w.nodes} />
      </figure>
    </div>
  </div>
</section>

<style>
  /* List left, map right once there is room for the map to keep its labels
     legible (they are SVG text and scale with the map's width). */
  .where-grid { display: grid; gap: var(--s-7); align-items: start; }
  @media (min-width: 960px) {
    .where-grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    /* The list is taller than the map; keep the map in view while reading it. */
    .map { position: sticky; top: calc(var(--nav-h) + var(--s-5)); }
  }

  .nodes { list-style: none; }
  .node {
    display: grid; grid-template-columns: 20px 1fr; gap: var(--s-5);
    padding-block: var(--s-5);
    border-top: 1px solid var(--hairline);
  }
  .node:last-child { border-bottom: 1px solid var(--hairline); }
  .node-dot {
    width: 13px; height: 13px; border-radius: 50%;
    margin-top: 6px; border: 2px solid var(--muted);
  }
  /* base = hollow grey · direct = solid (we were in the room) · curriculum = half
     · worked = hollow brass (we work there; relationship not stated) */
  .node--direct     .node-dot { background: var(--accent); border-color: var(--accent); }
  .node--curriculum .node-dot {
    border-color: var(--accent);
    background: linear-gradient(90deg, var(--accent) 50%, transparent 50%);
  }
  .node--worked     .node-dot { border-color: var(--accent); }
  .node-head { display: flex; align-items: baseline; gap: var(--s-3); flex-wrap: wrap; }
  .node-place { font-size: var(--t-body); font-weight: 600; }
  .node-text { font-size: var(--t-meta); color: var(--muted); margin-top: var(--s-2); max-width: 62ch; }

  .map {
    background: var(--surface); border: 1px solid var(--hairline);
    border-radius: var(--radius); padding: var(--s-4);
  }

  @media (max-width: 760px) {
    .node { grid-template-columns: 16px 1fr; gap: var(--s-4); }
  }
</style>
