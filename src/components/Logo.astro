---
/**
 * EN2U mark — "Cradle" (option A).
 *
 * Redrawn from pictures/logo.png, which could not be traced (42,149 colours,
 * woven patch texture, hand-lettered wordmark, 408px source).
 *
 * Geometry note: the hands wrap UP the sides of the globe with a gap at the
 * bottom centre. An arc sitting *beneath* the globe reads as a smiley face at
 * favicon size — the bottom gap and the raised shoulders are what stop that.
 *
 * Stroke-based with semantic per-path ids so the preloader can draw it on.
 * pathLength="1" normalises every path so one dashoffset value works for all.
 * Draw order below is the order a human would draw it, not DOM convenience.
 */
export interface Props {
  size?: number;
  detail?: boolean;   // false = simplified form for <= 24px
  title?: string;
  class?: string;
  id?: string;
}
const { size = 32, detail = true, title = 'EN2U', class: cls = '', id } = Astro.props;
const sw = size <= 24 ? 4.5 : size <= 32 ? 4 : size <= 64 ? 3.4 : 3;
---
<svg
  id={id}
  class={`en2u-mark ${cls}`}
  width={size} height={size} viewBox="0 0 64 64"
  role="img" aria-label={title}
  fill="none" stroke="currentColor" stroke-width={sw}
  stroke-linecap="round" stroke-linejoin="round"
>
  <title>{title}</title>
  <circle  class="m-path" data-draw="1" pathLength="1" cx="32" cy="25" r="13" />
  {detail && <path    class="m-path" data-draw="2" pathLength="1" d="M19 25H45" />}
  {detail && <ellipse class="m-path" data-draw="3" pathLength="1" cx="32" cy="25" rx="7" ry="13" />}
  <path class="m-path" data-draw="4" pathLength="1" d="M28.38 50.75A26 26 0 0 1 6.89 18.27" />
  <path class="m-path" data-draw="5" pathLength="1" d="M57.11 18.27A26 26 0 0 1 35.62 50.75" />
</svg>
